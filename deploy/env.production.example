# Production env for EC2 — copy to /opt/wrestling/.env (do not commit secrets)

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
DEBUG=False
SECURE_SSL_REDIRECT=True
ALLOWED_HOSTS=16.16.113.6
CSRF_TRUSTED_ORIGINS=https://16.16.113.6

DATABASE_NAME=wrestling_db
DATABASE_USER=wrestling
DATABASE_PASSWORD=CHANGE_ME
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

CORS_ALLOWED_ORIGINS=https://16.16.113.6

ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7
ALLOW_COACH_REGISTRATION=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@wrestlingguide.local
PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=True

MAX_VIDEO_UPLOAD_MB=0

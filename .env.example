# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
# Include your Tailscale Funnel hostname after enabling Funnel, e.g.:
# ALLOWED_HOSTS=localhost,127.0.0.1,your-machine.your-tailnet.ts.net
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Trusted HTTPS origins for CSRF (Swagger / browser clients via Funnel)
# CSRF_TRUSTED_ORIGINS=https://your-machine.your-tailnet.ts.net

# Database Configuration — PostgreSQL (Required)
DATABASE_NAME=wrestling_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# CORS Configuration (add Funnel HTTPS origin for browser clients)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# JWT Settings
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Future coach self-registration (keep False for now)
ALLOW_COACH_REGISTRATION=False

# Email (console backend prints reset emails in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@wrestlingguide.local
# Return uid/token in forgot-password JSON for mobile reset flow
PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=True

# Student video upload — 0 = no API size limit (disk / Gemini quotas still apply)
MAX_VIDEO_UPLOAD_MB=0

# AI pipeline — Gemini Flash only. AI_ANALYSIS_SYNC=true runs analysis in-process (tests).
AI_ANALYSIS_SYNC=False
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_MAX_KEY_MOMENTS=40

# Firebase Cloud Messaging (path to service account JSON; leave empty to skip real FCM)
# Example: FIREBASE_CREDENTIALS_FILE=wrerstlingapp-firebase-adminsdk.json
FIREBASE_CREDENTIALS_FILE=

# S3 media (EC2 IAM instance role — leave AWS keys unset on the server)
USE_S3=False
AWS_STORAGE_BUCKET_NAME=vision-quest-ai-videos
AWS_S3_REGION_NAME=eu-north-1
# Signed URLs for private buckets (recommended)
AWS_QUERYSTRING_AUTH=True
# Signed URL lifetime in seconds (6 hours)
AWS_QUERYSTRING_EXPIRE=21600
# Optional CloudFront / custom domain (no https:// prefix)
# AWS_S3_CUSTOM_DOMAIN=cdn.example.com
# EC2 instance profile / IAM role name (attach on the instance; not an env var boto3 reads):
# VisionQuestEC2S3Role
# Optional local-only keys (never put these on EC2 when using an IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
